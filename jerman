#!/bin/bash
echo "📦 Menginstal dependensi..."
apt-get update && apt-get install -y screen wget tar git build-essential

echo "📁 Menyimpan skrip mining ke /root/web.sh..."
cat << 'EOF' > /root/web.sh
#!/bin/bash

cd /root || exit

# Download cpuminer-opt jika belum ada
if [ ! -f cpuminer ]; then
  echo "⬇️ Mengunduh dan membangun cpuminer-opt..."
  git clone https://github.com/JayDDee/cpuminer-opt.git
  cd cpuminer-opt
  ./build.sh
  chmod +x cpuminer
else
  cd cpuminer-opt
fi

# Cek apakah screen sudah berjalan
if screen -list | grep -q amirul3; then
  echo "⚠️  Screen 'amirul3' sudah jalan, skip."
else
  echo "▶ Menjalankan mining di screen 'amirul3'..."
  screen -dmS amirul3 bash -c '
    while true; do
      ./cpuminer -a yescrypt -o stratum+tcp://yescrypt.sea.mine.zpool.ca:6233 -u ltc1q682mxnytl67x3gdw8eezxpuq4pehz5qhax4ls5.jp -p c=LTC,zap=BSTY -t 7
      sleep 2
    done
  '
fi
EOF

chmod +x /root/web.sh

echo "🚀 Menjalankan miner sekarang..."
bash /root/web.sh

echo "✅ Siap! Mining aktif sekarang & otomatis jalan setelah reboot lewat /etc/rc.local."
