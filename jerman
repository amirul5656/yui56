#!/bin/bash
echo "📦 Menginstal dependensi..."
apt update -y && apt install -y screen wget tar

echo "📁 Menyiapkan direktori mining..."
cd /root
mkdir -p pooler
cd pooler

if [ ! -f minerd ]; then
  echo "⬇️ Mengunduh dan mengekstrak cpuminer pooler 2.5.1..."
  wget https://github.com/pooler/cpuminer/releases/download/v2.5.1/pooler-cpuminer-2.5.1-linux-x86_64.tar.gz
  tar -xvzf pooler-cpuminer-2.5.1-linux-x86_64.tar.gz
  chmod +x minerd
fi

echo "▶ Menjalankan mining di screen 'amirul3'..."
screen -dmS amirul3 bash -c '
  while true; do
    ./minerd -a power2b  -o stratum+tcps://stratum-asia.rplant.xyz:17022 -u mbc1qse2ad4q6lwgtpqj0ls6hg2qp4fp9dm3ht4z5vg -t 7
    sleep 5
  done
'
